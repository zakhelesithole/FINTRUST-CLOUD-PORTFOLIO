print("3. Daily limit checker")
print("-" * 40)

def check_daily_limit_fixed(limit, used, amount):
    remaining = limit - used
    return amount <= remaining

account = {"daily_limit": 5000.0, "daily_used": 4500.0}
amount = 600.0

print(f"  Limit: R{account['daily_limit']:.2f}")
print(f"  Used: R{account['daily_used']:.2f}")
print(f"  Requested: R{amount:.2f}")

if check_daily_limit_fixed(account["daily_limit"], account["daily_used"], amount):
    print("  Within daily limit")
else:
    print("  Daily limit exceeded")
print()

